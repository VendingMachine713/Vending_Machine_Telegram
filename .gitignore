config.local.*

# ============================================================
# VM Platform generated/local runtime state
# ============================================================

# Runtime locks and transient runtime state
**/runtime/*.lock/
**/runtime/**/*.lock/
**/runtime/**/owner.json

# Local bot runtime state
bots/Universal_Search/state/*
!bots/Universal_Search/state/.gitkeep

bots/VM_Guard/state/*
!bots/VM_Guard/state/.gitkeep

# Central platform owner identity (numeric Telegram IDs; local-only)
state/security/owner_user_ids.txt

# Generated support bundles
state/support/*
!state/support/.gitkeep

# Ad-hoc source backups
*.bak_*
*.backup
*.backup_*

