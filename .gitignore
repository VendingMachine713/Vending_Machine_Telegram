# ---------- Secrets / credentials ----------
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

*.pem
*.key
*.p12
*.pfx

credentials.json
credentials*.json
client_secret*.json
secrets.json
secret.json
token.json
tokens.json

# ---------- Telegram sessions ----------
*.session
*.session-journal
**/*.session
**/*.session-journal

# ---------- Runtime databases ----------
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite-journal

# ---------- Python ----------
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
*.pyd

.venv/
venv/
env/
**/.venv/
**/venv/

.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Logs ----------
*.log
logs/
log/
**/logs/
**/log/

shared/logs/

# ---------- Runtime exports / backups ----------
backups/
**/backups/
shared/backups/

exports/
**/exports/
shared/exports/

# ---------- Cache / temporary ----------
cache/
**/cache/
tmp/
temp/
**/tmp/
**/temp/

*.tmp
*.temp
*.bak

# ---------- IDE / editor ----------
.vscode/
.idea/
*.code-workspace

