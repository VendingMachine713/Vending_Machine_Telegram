# Smart Auto Poster V3.0 local secrets/configuration.
# Copy to .env and enter your own values locally.
# NEVER paste API_HASH, bot tokens, login codes or .session contents into chat.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Each bot owns its own runtime/session folder to avoid concurrent SQLite session locking.
PRIMARY_SESSION=runtime/sessions/my_account
SECONDARY_SESSION=runtime/sessions/Auto_Post_Secondary

DATABASE_PATH=data/smart_autoposter.sqlite3
CONFIG_CSV=config/telegram_recommended_config.csv
MEDIA_CACHE_DIR=data/cache
BACKUP_DIR=backups
LOG_DIR=logs
DIAGNOSTICS_DIR=diagnostics
UPDATE_DIR=updates
DEFAULT_TIMEZONE=Australia/Adelaide
MIN_SEND_GAP_SECONDS=3

PRIMARY_STAGING_CHAT_ID=-5373297650
SECONDARY_STAGING_CHAT_ID=

# Reliability / unattended safety
RUNTIME_LOCK_PATH=runtime/telegram_runtime.lock
AUTH_REFRESH_SECONDS=300
CIRCUIT_BREAKER_FAILURES=10
CIRCUIT_BREAKER_WINDOW_MINUTES=10
CIRCUIT_BREAKER_PAUSE_MINUTES=30
CIRCUIT_BREAKER_FAILURE_RATIO=0.80
AUTO_BACKUP_HOURS=24
AUTO_BACKUP_KEEP=14

# Production campaign automation
CONTENT_ROOT=content
AUTO_RESCAN_MINUTES=360
DAILY_SUMMARY_HOURS=24
WEEKLY_SUMMARY_HOURS=168
MAINTENANCE_HOURS=24

# Queue capacity guardrails
MAX_QUEUE_SIZE=50000
MAX_PENDING_PER_CAMPAIGN=10000
MAX_PENDING_PER_DESTINATION=100

# Watchdog / connectivity recovery
WATCHDOG_SECONDS=30
HEARTBEAT_STALE_SECONDS=180
NETWORK_CHECK_HOST=telegram.org
NETWORK_CHECK_PORT=443
RECONNECT_INITIAL_SECONDS=15
RECONNECT_MAX_SECONDS=300

# Retention / housekeeping
QUEUE_HISTORY_DAYS=180
EVENT_RETENTION_DAYS=90
LOG_RETENTION_DAYS=30

# Telegram administration is intentionally NOT configured here.
# Smart Auto Poster owns posting only.
# Configure the standalone bot in bots/Admin_Command_Centre/.env using
# VM_ADMIN_BOT_TOKEN / VM_ADMIN_USER_IDS instead.

# Refresh recommendations every N hours
RECOMMENDATIONS_HOURS=24
# Apply user-created destination automation rules after live scans (off by default)
AUTO_APPLY_RULES_ON_SCAN=0
