
# ==========================================================
# VM RELATIONSHIP MANAGER
# Copy this file to .env and fill in your own credentials.
# NEVER share your real .env file.
# ==========================================================

TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
BOT_TOKEN=

# Comma-separated numeric Telegram IDs allowed to administer the bot.
ADMIN_IDS=

# Normally leave these defaults alone.
TIMEZONE=Australia/Adelaide
DAILY_DIGEST_HOUR=9

# python-telegram-bot weekday numbers:
# Sunday=0, Monday=1, Tuesday=2, Wednesday=3,
# Thursday=4, Friday=5, Saturday=6
WEEKLY_DIGEST_WEEKDAY=1
WEEKLY_DIGEST_HOUR=9

# Optional path overrides.
# If omitted, master-project shared folders are used automatically:
# DATABASE_PATH -> shared/exports/VM_Relationship_Manager/
# BACKUP_DIR    -> shared/backups/VM_Relationship_Manager/
# LOG_DIR       -> shared/logs/VM_Relationship_Manager/
#
# DATABASE_PATH=
# BACKUP_DIR=
# LOG_DIR=
#
# Optional custom Telethon session path/name.
# SESSION_NAME=
