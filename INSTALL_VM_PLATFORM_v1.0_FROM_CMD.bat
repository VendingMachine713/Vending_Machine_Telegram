@echo off
setlocal EnableExtensions
title VM Platform v1.0.0 Installer

set "VMROOT=%USERPROFILE%\OneDrive\Desktop\Vending_Machine_Telegram"
if not exist "%VMROOT%\bots" set "VMROOT=%USERPROFILE%\Desktop\Vending_Machine_Telegram"

echo.
echo ============================================================
echo  VM PLATFORM v1.0.0 - SAFE INSTALLER
echo ============================================================
echo.

if not exist "%VMROOT%\bots" (
  echo [ERROR] Could not find Vending_Machine_Telegram\bots.
  pause
  exit /b 1
)

echo [OK] Project root: %VMROOT%
echo [INFO] Using parser-safe encoded PowerShell installer.
echo.
powershell.exe -NoProfile -ExecutionPolicy Bypass -EncodedCommand 
set "RC=%ERRORLEVEL%"
echo.
if "%RC%"=="0" (
  echo [OK] VM Platform v1.0.0 completed.
  echo [NEXT] Double-click VM_CONTROL.bat in the project folder.
) else (
  echo [ERROR] Installer returned exit code %RC%.
  echo [INFO] Send this window output back if it fails.
)
echo.
pause
exit /b %RC%
